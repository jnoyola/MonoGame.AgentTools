<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <VersionPrefix>0.2.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <Authors>Jonathan Noyola</Authors>
    <Copyright>Copyright (c) 2026 Jonathan Noyola</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jnoyola/MonoGame.AgentTools</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jnoyola/MonoGame.AgentTools</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- SourceLink (built into the .NET SDK) so debuggers can step into the library's source. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
</Project>
