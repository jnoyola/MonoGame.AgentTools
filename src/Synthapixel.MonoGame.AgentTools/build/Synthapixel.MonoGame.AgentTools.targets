<Project>
  <!--
    AgentToolsEnabled: true in Debug by default. When false, calls to AgentTools.Attach are compiled out
    ([Conditional("AGENTTOOLS")]) and the assembly is left out of the build and publish output.
  -->
  <PropertyGroup>
    <AgentToolsEnabled Condition="'$(AgentToolsEnabled)' == '' and '$(Configuration)' == 'Debug'">true</AgentToolsEnabled>
    <DefineConstants Condition="'$(AgentToolsEnabled)' == 'true'">$(DefineConstants);AGENTTOOLS</DefineConstants>
  </PropertyGroup>

  <!--
    Where live play records sessions (.agenttools/sessions), read with AppContext.GetData: AgentToolsRoot
    when set, else the .git root above the project, found the same way as for .mcp.json below.
  -->
  <ItemGroup Condition="'$(AgentToolsEnabled)' == 'true'">
    <RuntimeHostConfigurationOption Include="Synthapixel.MonoGame.AgentTools.ProjectDirectory" Value="$(MSBuildProjectDirectory)" />
    <RuntimeHostConfigurationOption Include="Synthapixel.MonoGame.AgentTools.Root" Condition="'$(AgentToolsRoot)' != ''" Value="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(AgentToolsRoot)'))" />
  </ItemGroup>

  <Target Name="AgentToolsExcludeFromOutput" AfterTargets="ResolvePackageAssets" Condition="'$(AgentToolsEnabled)' != 'true'">
    <ItemGroup>
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Synthapixel.MonoGame.AgentTools'" />
    </ItemGroup>
  </Target>

  <!--
    Adds the MCP server to the repository's .mcp.json (and .vscode/mcp.json, .cursor/mcp.json where those
    folders exist) on build, merging into what's there and rewriting only when the package version
    changes. AgentToolsInstallMcp=false opts out; AgentToolsRoot picks the folder instead of the .git root.
    Skipped in CI and design-time builds, and without a package version (referenced as a project).
  -->
  <UsingTask TaskName="Synthapixel.MonoGame.AgentTools.Build.AddAgentToolsMcpServer" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)McpConfig.cs" />
    </Task>
  </UsingTask>

  <Target Name="AgentToolsAddMcpServer" AfterTargets="Build"
          Condition="'$(AgentToolsEnabled)' == 'true' and '$(AgentToolsInstallMcp)' != 'false' and '$(AgentToolsPackageVersion)' != '' and '$(DesignTimeBuild)' != 'true' and '$(ContinuousIntegrationBuild)' != 'true' and '$(CI)' != 'true' and '$(TF_BUILD)' == ''">
    <AddAgentToolsMcpServer Root="$(AgentToolsRoot)" StartDirectory="$(MSBuildProjectDirectory)" PackageVersion="$(AgentToolsPackageVersion)" />
  </Target>
</Project>
