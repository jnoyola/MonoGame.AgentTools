<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Synthapixel.MonoGame.AgentTools.Mcp</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <ToolCommandName>monogame-agenttools</ToolCommandName>
    <PackageId>Synthapixel.MonoGame.AgentTools.Mcp</PackageId>
    <Description>MCP server for Synthapixel.MonoGame.AgentTools: builds and captures a MonoGame game, and returns its frames, contact sheets and measurements to a coding agent.</Description>
    <PackageTags>monogame;agent;mcp;capture;profiling;testing</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the library: the MonoGame-free part of the HUD font, for labels. -->
    <Compile Include="..\Synthapixel.MonoGame.AgentTools\Hud\PixelFont.cs" Link="Imaging\PixelFont.cs" />
    <EmbeddedResource Include="..\Synthapixel.MonoGame.AgentTools\Hud\Fonts\ProggyClean.txt" LogicalName="Synthapixel.MonoGame.AgentTools.Hud.Fonts.ProggyClean.txt" />
    <EmbeddedResource Include="Guide\*.md" LogicalName="Synthapixel.MonoGame.AgentTools.Mcp.Guide.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Synthapixel.MonoGame.AgentTools.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".mcp\server.json" Pack="true" PackagePath="\.mcp\" />
    <None Include="..\..\docs\package-readme.md" Pack="true" PackagePath="\README.md" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
