<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MonoGame.AgentTools</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- LibraryImport's generated marshalling, glReadPixels and native file writes. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Optimized in every configuration, so a game's Debug build referencing this project captures as
         fast as the published (Release) package; the PNG encoder is several times slower unoptimized. -->
    <Optimize>true</Optimize>
    <IsPackable>true</IsPackable>
    <PackageId>MonoGame.AgentTools</PackageId>
    <Description>Development-time tools that let coding agents run a MonoGame game deterministically, capture frames and measure it. Compiled out of Release builds by default.</Description>
    <PackageTags>monogame;agent;mcp;capture;profiling;testing</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time only: the consumer's MonoGame platform package provides the runtime assembly. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5" PrivateAssets="all" ExcludeAssets="runtime;native;build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Hud\Fonts\*.txt" LogicalName="MonoGame.AgentTools.Hud.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MonoGame.AgentTools.Tests" />
    <InternalsVisibleTo Include="MonoGame.AgentTools.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- build\McpConfig.cs is compiled by MSBuild in the consuming build, not into this assembly. -->
    <Compile Remove="build\**" />
    <None Include="build\**" Pack="true" PackagePath="build\" />
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive\" />
    <None Include="..\..\docs\package-readme.md" Pack="true" PackagePath="\README.md" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    The package's own version, for the build targets to put in .mcp.json. NuGet imports
    build/<id>.props before the project, so it's set wherever the package is referenced.
  -->
  <Target Name="AgentToolsWriteVersionProps" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_AgentToolsVersionProps>$(IntermediateOutputPath)pack\MonoGame.AgentTools.props</_AgentToolsVersionProps>
    </PropertyGroup>
    <WriteLinesToFile File="$(_AgentToolsVersionProps)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="&lt;Project&gt;&lt;PropertyGroup&gt;&lt;AgentToolsPackageVersion&gt;$(PackageVersion)&lt;/AgentToolsPackageVersion&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;" />
    <ItemGroup>
      <None Include="$(_AgentToolsVersionProps)" Pack="true" PackagePath="build\;buildTransitive\" />
    </ItemGroup>
  </Target>

</Project>
