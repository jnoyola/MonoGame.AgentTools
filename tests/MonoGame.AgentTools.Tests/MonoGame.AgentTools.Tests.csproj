<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The lowest runtime games can use and the newest: the library measures the runtime, which differs between them. -->
    <TargetFrameworks>net8.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 10.0 is the newest that supports net8.0. -->
    <PackageReference Include="System.IO.Hashing" Version="10.0.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MonoGame.AgentTools\MonoGame.AgentTools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The build task's source, compiled by MSBuild in consuming builds; tested here directly. It runs in
    MSBuild on the SDK's runtime, never the game's, so it isn't tested on net8.0.
  -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" />
    <Compile Include="..\..\src\MonoGame.AgentTools\build\McpConfig.cs" Link="McpConfig.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="McpConfigTests.cs" />
  </ItemGroup>

</Project>
